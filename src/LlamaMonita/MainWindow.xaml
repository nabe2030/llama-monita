<Window x:Class="LlamaMonita.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LlamaMonita"
        Title="LlamaMonita" Width="1000" Height="760" MinWidth="780" MinHeight="560"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Yu Gothic UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Border x:Name="Shell" Background="{StaticResource BgBrush}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- connection bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UrlBox" KeyDown="UrlBox_KeyDown"/>
                <Button Grid.Column="1" Content="Connect" Margin="8,0,0,0" Click="Connect_Click"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Status}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ServerInfo}" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox Grid.Column="3" Content="Always on top" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                          Checked="Pin_Changed" Unchecked="Pin_Changed" x:Name="PinBox"/>
            </Grid>

            <!-- model + throughput -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="MODEL" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding ModelName}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <TextBlock Text="{Binding ModelDetail}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Ellipse Width="10" Height="10" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding State}" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="GENERATION SPEED" Style="{StaticResource Label}" Grid.ColumnSpan="2"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding TokensPerSecond}" Style="{StaticResource Big}" Foreground="{StaticResource GreenBrush}"/>
                            <TextBlock Text="tok/s" Style="{StaticResource Muted}" Margin="6,0,0,7" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <local:Sparkline Grid.Row="1" Grid.Column="1" Values="{Binding TpsHistory}" Stroke="{StaticResource GreenBrush}"
                                         Height="44" Margin="18,2,0,0"/>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Session}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding ServerTotals}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- GPUs -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Gpus}" Margin="0,0,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.ColumnSpan="4" Orientation="Horizontal">
                                    <Border Background="#1E3A5F" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,6,0,0" MinWidth="120">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding UtilText}" Style="{StaticResource Big}" Foreground="{StaticResource BlueBrush}"/>
                                        <TextBlock Text="%" Style="{StaticResource Muted}" Margin="4,0,0,7" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding Engine}" Style="{StaticResource Muted}" Margin="8,0,0,7" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock Text="GPU utilization" Style="{StaticResource Muted}"/>
                                </StackPanel>
                                <local:Sparkline Grid.Row="1" Grid.Column="1" Values="{Binding UtilHistory}" Maximum="100"
                                                 Stroke="{StaticResource BlueBrush}" Height="56" Margin="12,8,0,0"/>

                                <StackPanel Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="0,8,0,0">
                                    <Grid>
                                        <TextBlock Text="Dedicated GPU memory" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding DedicatedText}" HorizontalAlignment="Right" FontSize="12"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding DedicatedFraction, Mode=OneWay}" Margin="0,5,0,12"/>
                                    <Grid>
                                        <TextBlock Text="Shared GPU memory" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding SharedText}" HorizontalAlignment="Right" FontSize="12"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding SharedFraction, Mode=OneWay}" Foreground="{StaticResource AmberBrush}" Margin="0,5,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Text="{Binding Sensors}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- slots / models / system -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="SLOTS" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding SlotsNote}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                            <ItemsControl ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4,0,10">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" Margin="10,1,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding Fraction, Mode=OneWay}" Foreground="{StaticResource GreenBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding ShowModels, Converter={StaticResource BoolVis}}" Margin="0,8,0,0">
                                <TextBlock Text="MODELS (ROUTER)" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Models}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Id}" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding Brush}" FontSize="12" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SYSTEM" Style="{StaticResource Label}"/>
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="CPU" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding CpuText}" HorizontalAlignment="Right" FontSize="12"/>
                        </Grid>
                        <ProgressBar Value="{Binding CpuFraction, Mode=OneWay}" Foreground="#A78BFA" Margin="0,5,0,12"/>
                        <Grid>
                            <TextBlock Text="Memory" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding RamText}" HorizontalAlignment="Right" FontSize="12"/>
                        </Grid>
                        <ProgressBar Value="{Binding RamFraction, Mode=OneWay}" Foreground="#A78BFA" Margin="0,5,0,14"/>
                        <TextBlock Text="{Binding ProcessText}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
