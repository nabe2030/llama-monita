<Window x:Class="LlamaMonita.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LlamaMonita"
        Title="{Binding WindowTitle}" Icon="Assets/LlamaMonita.ico" Width="1080" Height="820" MinWidth="320" MinHeight="170"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Yu Gothic UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#A78BFA"/>

        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="Pill" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#252A35"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1E3A5F"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" Background="{StaticResource BgBrush}" Padding="16" SizeChanged="Shell_SizeChanged">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="PinMenu" Header="Always on top" IsCheckable="True" Click="PinMenu_Click"/>
                <Separator/>
                <MenuItem Header="Compact size" Click="SizeCompact_Click"/>
                <MenuItem Header="Graphs only" Click="SizeGraphs_Click"/>
                <MenuItem Header="Standard size" Click="SizeStandard_Click"/>
                <Separator/>
                <MenuItem Header="Open request log folder" Click="OpenLogFolder_Click"/>
                <MenuItem Header="Release notes" Click="VersionLink_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- connection bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12" Visibility="{Binding ShowTopBar, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SERVER" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding ShowServerLabel, Converter={StaticResource BoolVis}}"/>
                    <TextBox x:Name="UrlBox" Width="190" KeyDown="UrlBox_KeyDown" TextChanged="UrlBox_TextChanged" ToolTip="Address of the llama-server to watch. Edit it and press Enter or Connect to switch servers."/>
                </StackPanel>
                <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect" Margin="8,0,0,0" Click="Connect_Click" IsEnabled="False" ToolTip="Switch to the server address typed on the left"/>
                <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,12,0" LastChildFill="True">
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ServerInfo}" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="LogToggle" Content="Log" Style="{StaticResource Pill}" Margin="0,0,8,0" Click="LogToggle_Click"
                                  ToolTip="Prefer the request log over the details row when the window is too small for both"/>
                    <ToggleButton x:Name="PinToggle" Content="On top" Style="{StaticResource Pill}" Click="PinToggle_Click" ToolTip="Keep this window above other windows"/>
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12">
                        <Hyperlink Click="VersionLink_Click" Foreground="{StaticResource MutedBrush}" TextDecorations="{x:Null}" ToolTip="Open the release notes of this version">
                            <Run x:Name="VersionRun" Text="v0.0.0"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- combined graph: GPU utilization (left axis) and generation speed (right axis) -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- left: one block per GPU, in the colour of its line -->
                        <ItemsControl ItemsSource="{Binding Gpus}" ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,16,0">
                                        <DockPanel LastChildFill="True" MaxWidth="300" HorizontalAlignment="Left">
                                            <Border DockPanel.Dock="Left" Background="#1E2A44" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Brush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding UtilText}" Style="{StaticResource Big}" Foreground="{Binding Brush}" Width="62" TextAlignment="Right"/>
                                            <TextBlock Text="%" Style="{StaticResource Muted}" FontSize="14" Margin="4,0,0,8" VerticalAlignment="Bottom"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                                        Visibility="{Binding DataContext.ShowTiles, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                                                <StackPanel Margin="16,0,0,0" Width="86" ToolTip="Busiest GPU engine. Compute = Vulkan / CUDA work such as llama.cpp; 3D = desktop rendering.">
                                                    <TextBlock Text="ENGINE" Style="{StaticResource Label}"/>
                                                    <TextBlock Text="{Binding Engine}" Style="{StaticResource TileValue}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <StackPanel Margin="16,0,0,0" Width="60" Visibility="{Binding HasTemp, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="TEMP" Style="{StaticResource Label}"/>
                                                    <TextBlock Text="{Binding TempText}" Style="{StaticResource TileValue}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <StackPanel Margin="16,0,0,0" Width="54" Visibility="{Binding HasPower, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="POWER" Style="{StaticResource Label}"/>
                                                    <TextBlock Text="{Binding PowerText}" Style="{StaticResource TileValue}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <StackPanel Margin="16,0,0,0" Width="84" Visibility="{Binding HasFan, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="FAN" Style="{StaticResource Label}"/>
                                                    <TextBlock Text="{Binding FanText}" Style="{StaticResource TileValue}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- right: generation speed, next to the right-hand axis -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding State}" Style="{StaticResource Muted}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,16,5"
                                            Visibility="{Binding ShowTokenTiles, Converter={StaticResource BoolVis}}">
                                    <StackPanel Width="84" ToolTip="Prompt tokens processed since this window connected">
                                        <TextBlock Text="PROMPT" Style="{StaticResource TileLabel}"/>
                                        <TextBlock Text="{Binding SessionPrompt}" Style="{StaticResource TileValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="16,0,0,0" Width="90" ToolTip="Tokens generated since this window connected">
                                        <TextBlock Text="GENERATED" Style="{StaticResource TileLabel}"/>
                                        <TextBlock Text="{Binding SessionGenerated}" Style="{StaticResource TileValue}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding TokensPerSecond}" Style="{StaticResource Big}" Foreground="{StaticResource GreenBrush}" Width="96" TextAlignment="Right"/>
                                <TextBlock Text="tok/s" Style="{StaticResource Muted}" FontSize="14" Margin="6,0,0,8" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <local:HistoryChart Grid.Row="1" Series="{Binding HeroSeries}" Maximum="100" Unit="%" RightUnit="tok/s" MinHeight="24"/>

                    <!-- memory, one row per GPU -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Gpus}" Margin="0,6,0,0"
                                  Visibility="{Binding ShowFooter, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Dedicated GPU memory" Style="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding DedicatedText}" HorizontalAlignment="Right" FontSize="12"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding DedicatedFraction, Mode=OneWay}" Foreground="{Binding Brush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <TextBlock Text="Shared GPU memory" Style="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding SharedText}" HorizontalAlignment="Right" FontSize="12"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding SharedFraction, Mode=OneWay}" Foreground="{StaticResource AmberBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- compact details: models and system -->
            <UniformGrid x:Name="InfoGrid" Grid.Row="2" Margin="-6,6,-6,-6" Rows="1"
                         Visibility="{Binding ShowInfo, Converter={StaticResource BoolVis}}">
                <Border Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding ModelsTitle}" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                            <ItemsControl ItemsSource="{Binding Models}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Id}" Margin="8,0,8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding Brush}" FontSize="12"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="15,1,0,2"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Text="SYSTEM" Style="{StaticResource Label}"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="CPU" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <local:HistoryChart Grid.Column="1" Values="{Binding CpuHistory}" Maximum="100" ShowAxis="False"
                                                Stroke="{StaticResource PurpleBrush}" Margin="4,3,10,3"/>
                            <TextBlock Grid.Column="2" Text="{Binding CpuText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="RAM" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <local:HistoryChart Grid.Row="1" Grid.Column="1" Values="{Binding RamHistory}" Maximum="100" ShowAxis="False"
                                                Stroke="{StaticResource PurpleBrush}" Margin="4,3,10,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RamText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- request log: when, from where, how much -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,12"
                    Visibility="{Binding ShowRequests, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="REQUESTS" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding MetricsNote}" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding RequestsNote}" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding TodayText}" FontSize="11.5" ToolTip="{Binding DailyTooltip}" ToolTipService.ShowDuration="30000"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,18,4">
                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="STARTED" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBlock Grid.Column="2" Text="FROM" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBlock Grid.Column="3" Text="MODEL" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBlock Grid.Column="4" Text="SLOT" Style="{StaticResource Label}" FontSize="10" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="PROMPT" Style="{StaticResource Label}" FontSize="10" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="GENERATED" Style="{StaticResource Label}" FontSize="10" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="7" Text="TOOK" Style="{StaticResource Label}" FontSize="10" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="8" Text="TOK/S" Style="{StaticResource Label}" FontSize="10" HorizontalAlignment="Right"/>
                    </Grid>
                    <ScrollViewer Grid.Row="2" Height="92" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <TextBlock Text="No requests since this window connected" Margin="16,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Requests.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Requests}" Margin="0,0,18,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Time}" Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Grid.Column="2" Text="{Binding From}" TextTrimming="CharacterEllipsis" ToolTip="{Binding From}" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Model}" Style="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Slot}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Prompt}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Grid.Column="6" Text="{Binding Generated}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Grid.Column="7" Text="{Binding Duration}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="8" Text="{Binding Speed}" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
