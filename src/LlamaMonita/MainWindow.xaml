<Window x:Class="LlamaMonita.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LlamaMonita"
        Title="{Binding WindowTitle}" Width="1080" Height="760" MinWidth="320" MinHeight="170"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Yu Gothic UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#A78BFA"/>

        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>

        <Style x:Key="Pill" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#252A35"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1E3A5F"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" Background="{StaticResource BgBrush}" Padding="16" SizeChanged="Shell_SizeChanged">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="PinMenu" Header="Always on top" IsCheckable="True" Click="PinMenu_Click"/>
                <Separator/>
                <MenuItem Header="Compact size" Click="SizeCompact_Click"/>
                <MenuItem Header="Graphs only" Click="SizeGraphs_Click"/>
                <MenuItem Header="Standard size" Click="SizeStandard_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- connection bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12" Visibility="{Binding ShowTopBar, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UrlBox" Width="230" KeyDown="UrlBox_KeyDown"/>
                <Button Grid.Column="1" Content="Connect" Margin="8,0,0,0" Click="Connect_Click"/>
                <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,12,0" LastChildFill="True">
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ServerInfo}" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>
                <ToggleButton x:Name="PinToggle" Grid.Column="3" Content="Always on top" Style="{StaticResource Pill}" VerticalAlignment="Center"
                              Click="PinToggle_Click"/>
            </Grid>

            <!-- combined graph: GPU utilization (left axis) and generation speed (right axis) -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- left: one block per GPU, in the colour of its line -->
                        <ItemsControl ItemsSource="{Binding Gpus}" ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,28,0">
                                        <DockPanel LastChildFill="True" MaxWidth="300" HorizontalAlignment="Left">
                                            <Border DockPanel.Dock="Left" Background="#1E2A44" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Brush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding UtilText}" Style="{StaticResource Big}" Foreground="{Binding Brush}"/>
                                            <TextBlock Text="%" Style="{StaticResource Muted}" FontSize="14" Margin="4,0,0,8" VerticalAlignment="Bottom"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                                        Visibility="{Binding DataContext.ShowTiles, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                                                <StackPanel Margin="22,0,0,0">
                                                    <TextBlock Text="ENGINE" Style="{StaticResource Label}"/>
                                                    <TextBlock Text="{Binding Engine}" Style="{StaticResource TileValue}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <StackPanel Margin="22,0,0,0" Visibility="{Binding HasTemp, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="TEMP" Style="{StaticResource Label}"/>
                                                    <TextBlock Text="{Binding TempText}" Style="{StaticResource TileValue}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <StackPanel Margin="22,0,0,0" Visibility="{Binding HasPower, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="POWER" Style="{StaticResource Label}"/>
                                                    <TextBlock Text="{Binding PowerText}" Style="{StaticResource TileValue}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <StackPanel Margin="22,0,0,0" Visibility="{Binding HasFan, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="FAN" Style="{StaticResource Label}"/>
                                                    <TextBlock Text="{Binding FanText}" Style="{StaticResource TileValue}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- right: generation speed, next to the right-hand axis -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding State}" Style="{StaticResource Muted}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,22,5"
                                            Visibility="{Binding ShowTiles, Converter={StaticResource BoolVis}}">
                                    <StackPanel>
                                        <TextBlock Text="PROMPT TOKENS" Style="{StaticResource TileLabel}"/>
                                        <TextBlock Text="{Binding SessionPrompt}" Style="{StaticResource TileValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="22,0,0,0">
                                        <TextBlock Text="GENERATED TOKENS" Style="{StaticResource TileLabel}"/>
                                        <TextBlock Text="{Binding SessionGenerated}" Style="{StaticResource TileValue}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding TokensPerSecond}" Style="{StaticResource Big}" Foreground="{StaticResource GreenBrush}"/>
                                <TextBlock Text="tok/s" Style="{StaticResource Muted}" FontSize="14" Margin="6,0,0,8" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <local:HistoryChart Grid.Row="1" Series="{Binding HeroSeries}" Maximum="100" Unit="%" RightUnit="tok/s" MinHeight="24"/>

                    <!-- memory, one row per GPU -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Gpus}" Margin="0,6,0,0"
                                  Visibility="{Binding ShowFooter, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Dedicated GPU memory" Style="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding DedicatedText}" HorizontalAlignment="Right" FontSize="12"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding DedicatedFraction, Mode=OneWay}" Foreground="{Binding Brush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <TextBlock Text="Shared GPU memory" Style="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding SharedText}" HorizontalAlignment="Right" FontSize="12"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding SharedFraction, Mode=OneWay}" Foreground="{StaticResource AmberBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- compact details -->
            <UniformGrid x:Name="InfoGrid" Grid.Row="2" Margin="-6,6,-6,-6" Rows="1"
                         Visibility="{Binding ShowInfo, Converter={StaticResource BoolVis}}">
                <Border Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Text="MODEL" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding ModelName}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ModelDetail}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding ServerTotals}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="SLOTS" Style="{StaticResource Label}"/>
                            <TextBlock Text="context used" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding SlotsNote}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="92">
                            <ItemsControl ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title}" Margin="7,0,0,0" FontWeight="SemiBold" MinWidth="14"/>
                                            </StackPanel>
                                            <ProgressBar Grid.Column="1" Value="{Binding Fraction, Mode=OneWay}" Foreground="{StaticResource GreenBrush}"
                                                         Margin="8,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InfoCard}" Visibility="{Binding ShowModels, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="MODELS (ROUTER)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="96">
                            <ItemsControl ItemsSource="{Binding Models}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Id}" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding Brush}" FontSize="12"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Text="SYSTEM" Style="{StaticResource Label}"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="CPU" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <local:HistoryChart Grid.Column="1" Values="{Binding CpuHistory}" Maximum="100" ShowAxis="False"
                                                Stroke="{StaticResource PurpleBrush}" Margin="4,3,10,3"/>
                            <TextBlock Grid.Column="2" Text="{Binding CpuText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="RAM" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <local:HistoryChart Grid.Row="1" Grid.Column="1" Values="{Binding RamHistory}" Maximum="100" ShowAxis="False"
                                                Stroke="{StaticResource PurpleBrush}" Margin="4,3,10,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RamText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding ProcessText}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None" FontSize="11.5"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
